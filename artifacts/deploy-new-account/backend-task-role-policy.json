{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Sid":  "SqsCreateScreeningQueue",
                          "Effect":  "Allow",
                          "Action":  [
                                         "sqs:CreateQueue"
                                     ],
                          "Resource":  "*",
                          "Condition":  {
                                            "StringEquals":  {
                                                                 "sqs:QueueName":  "screening-requests"
                                                             }
                                        }
                      },
                      {
                          "Sid":  "SqsSendScreeningQueue",
                          "Effect":  "Allow",
                          "Action":  [
                                         "sqs:GetQueueUrl",
                                         "sqs:GetQueueAttributes",
                                         "sqs:SendMessage",
                                         "sqs:SendMessageBatch"
                                     ],
                          "Resource":  "arn:aws:sqs:us-east-2:981450247094:screening-requests"
                      },
                      {
                          "Sid":  "S3BucketProbe",
                          "Effect":  "Allow",
                          "Action":  [
                                         "s3:ListBucket"
                                     ],
                          "Resource":  "arn:aws:s3:::amzn-s3-quickscreen-batch-981450247094"
                      },
                      {
                          "Sid":  "S3UploadObjects",
                          "Effect":  "Allow",
                          "Action":  [
                                         "s3:PutObject",
                                         "s3:GetObject",
                                         "s3:DeleteObject"
                                     ],
                          "Resource":  "arn:aws:s3:::amzn-s3-quickscreen-batch-981450247094/screening-input/*"
                      },
                      {
                          "Sid":  "SnsSubscriptionManagement",
                          "Effect":  "Allow",
                          "Action":  [
                                         "sns:CreateTopic",
                                         "sns:GetTopicAttributes",
                                         "sns:Subscribe",
                                         "sns:ListSubscriptionsByTopic"
                                     ],
                          "Resource":  "arn:aws:sns:us-east-2:981450247094:ofac-screening-schedule*"
                      },
                      {
                          "Sid":  "SnsUnsubscribe",
                          "Effect":  "Allow",
                          "Action":  [
                                         "sns:Unsubscribe"
                                     ],
                          "Resource":  "*"
                      },
                      {
                          "Sid":  "CognitoListUsers",
                          "Effect":  "Allow",
                          "Action":  [
                                         "cognito-idp:ListUsers"
                                     ],
                          "Resource":  "arn:aws:cognito-idp:us-east-2:981450247094:userpool/us-east-2_ptvmAe35M"
                      }
                  ]
}