FROM node:22-alpine AS build

WORKDIR /frontend
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .
ARG VITE_SCREENING_API_BASE_URL=/api/v1
ARG VITE_SCREENING_POLL_INTERVAL_MS=750
ARG VITE_SCREENING_JOB_TIMEOUT_MS=90000
ARG VITE_AUTH_ENABLED=true
ARG VITE_OIDC_AUTHORITY=http://localhost:8081/realms/screening-local
ARG VITE_OIDC_CLIENT_ID=screening-frontend
ARG VITE_OIDC_REDIRECT_URI=http://localhost:8080/
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/
ARG VITE_OIDC_SCOPE=openid profile email roles
ARG VITE_OIDC_IDLE_TIMEOUT_MS=900000
ARG VITE_OIDC_CLEAR_SESSION_ON_CLOSE=true
ARG VITE_ACTIMIZE_REVIEW_ALERT_URL=
ENV VITE_SCREENING_API_BASE_URL=$VITE_SCREENING_API_BASE_URL
ENV VITE_SCREENING_POLL_INTERVAL_MS=$VITE_SCREENING_POLL_INTERVAL_MS
ENV VITE_SCREENING_JOB_TIMEOUT_MS=$VITE_SCREENING_JOB_TIMEOUT_MS
ENV VITE_AUTH_ENABLED=$VITE_AUTH_ENABLED
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_OIDC_POST_LOGOUT_REDIRECT_URI=$VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ENV VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE
ENV VITE_OIDC_IDLE_TIMEOUT_MS=$VITE_OIDC_IDLE_TIMEOUT_MS
ENV VITE_OIDC_CLEAR_SESSION_ON_CLOSE=$VITE_OIDC_CLEAR_SESSION_ON_CLOSE
ENV VITE_ACTIMIZE_REVIEW_ALERT_URL=$VITE_ACTIMIZE_REVIEW_ALERT_URL
RUN npm run build

FROM nginx:1.29-alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /frontend/dist /usr/share/nginx/html
COPY frontend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80
CMD ["/entrypoint.sh"]
