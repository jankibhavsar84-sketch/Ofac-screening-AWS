{
    "family":  "ofac-screening-frontend",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "512",
    "executionRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-execution-role",
    "taskRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-role",
    "containerDefinitions":  [
                                 {
                                     "name":  "frontend",
                                     "image":  "279930135954.dkr.ecr.us-east-2.amazonaws.com/ofac-screening-frontend:20260313182313",
                                     "essential":  true,
                                     "command":  [
                                                     "/entrypoint.sh"
                                                 ],
                                     "environment":  [

                                                     ],
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  80,
                                                              "hostPort":  80,
                                                              "protocol":  "tcp"
                                                          }
                                                      ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/ofac-screening-frontend",
                                                                              "awslogs-region":  "us-east-2",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          },
                                     "secrets":  [
                                                     {
                                                         "name":  "BACKEND_UPSTREAM",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:BACKEND_UPSTREAM::"
                                                     },
                                                     {
                                                         "name":  "VITE_SCREENING_API_BASE_URL",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_SCREENING_API_BASE_URL::"
                                                     },
                                                     {
                                                         "name":  "VITE_SCREENING_POLL_INTERVAL_MS",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_SCREENING_POLL_INTERVAL_MS::"
                                                     },
                                                     {
                                                         "name":  "VITE_SCREENING_JOB_TIMEOUT_MS",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_SCREENING_JOB_TIMEOUT_MS::"
                                                     },
                                                     {
                                                         "name":  "VITE_AUTH_ENABLED",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_AUTH_ENABLED::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_AUTHORITY",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_AUTHORITY::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_CLIENT_ID",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_CLIENT_ID::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_REDIRECT_URI",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_REDIRECT_URI::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_POST_LOGOUT_REDIRECT_URI",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_POST_LOGOUT_REDIRECT_URI::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_SCOPE",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_SCOPE::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_IDLE_TIMEOUT_MS",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_IDLE_TIMEOUT_MS::"
                                                     },
                                                     {
                                                         "name":  "VITE_OIDC_CLEAR_SESSION_ON_CLOSE",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/frontend-config:VITE_OIDC_CLEAR_SESSION_ON_CLOSE::"
                                                     }
                                                 ]
                                 }
                             ]
}