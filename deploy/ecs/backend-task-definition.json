{
    "family":  "ofac-screening-backend",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "1024",
    "executionRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-execution-role",
    "taskRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-role",
    "containerDefinitions":  [
                                 {
                                     "name":  "backend",
                                     "image":  "279930135954.dkr.ecr.us-east-2.amazonaws.com/ofac-screening-backend:20260311135758",
                                     "essential":  true,
                                     "command":  [
                                                     "uvicorn",
                                                     "app.main:app",
                                                     "--host",
                                                     "0.0.0.0",
                                                     "--port",
                                                     "8000"
                                                 ],
                                     "portMappings":  [
                                                          {
                                                              "name":  "api",
                                                              "containerPort":  8000,
                                                              "hostPort":  8000,
                                                              "protocol":  "tcp",
                                                              "appProtocol":  "http"
                                                          }
                                                      ],
                                     "environment":  [

                                                     ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/ofac-screening-backend",
                                                                              "awslogs-region":  "us-east-2",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          },
                                     "secrets":  [
                                                     {
                                                         "name":  "APP_DB_PATH",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:APP_DB_PATH::"
                                                     },
                                                     {
                                                         "name":  "CORS_ALLOW_ORIGINS",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:CORS_ALLOW_ORIGINS::"
                                                     },
                                                     {
                                                         "name":  "AWS_REGION",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:AWS_REGION::"
                                                     },
                                                     {
                                                         "name":  "AWS_SQS_QUEUE_NAME",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:AWS_SQS_QUEUE_NAME::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_MOCK",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_MOCK::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_LOG_RAW_API_IO",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_LOG_RAW_API_IO::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_RAW_API_LOG_MAX_CHARS",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_RAW_API_LOG_MAX_CHARS::"
                                                     },
                                                     {
                                                         "name":  "AUTH_ENABLED",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:AUTH_ENABLED::"
                                                     },
                                                     {
                                                         "name":  "AUTH_ISSUER",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:AUTH_ISSUER::"
                                                     },
                                                     {
                                                         "name":  "AUTH_JWKS_URL",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:AUTH_JWKS_URL::"
                                                     },
                                                     {
                                                         "name":  "AUTH_AUDIENCE",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:AUTH_AUDIENCE::"
