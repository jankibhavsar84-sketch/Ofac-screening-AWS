                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_SOURCE_SYSTEM",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_SOURCE_SYSTEM::"
