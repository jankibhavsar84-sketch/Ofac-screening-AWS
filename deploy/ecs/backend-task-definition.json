{
    "family":  "ofac-screening-backend",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "512",
    "executionRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-execution-role",
    "taskRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-role",
    "containerDefinitions":  [
                                 {
                                     "name":  "backend",
                                     "image":  "279930135954.dkr.ecr.us-east-2.amazonaws.com/ofac-screening-backend:20260227124223",
                                     "essential":  true,
                                     "command":  [
                                                     "sh",
                                                     "-c",
                                                     "python -m app.worker \u0026 uvicorn app.main:app --host 0.0.0.0 --port 8000"
                                                 ],
                                     "portMappings":  [
                                                          {
                                                              "name":  "api",
                                                              "containerPort":  8000,
                                                              "hostPort":  8000,
                                                              "protocol":  "tcp",
                                                              "appProtocol":  "http"
                                                          }
                                                      ],
                                     "environment":  [
                                                         {
                                                             "name":  "APP_DB_PATH",
                                                             "value":  "/tmp/screening.db"
                                                         },
                                                         {
                                                             "name":  "CORS_ALLOW_ORIGINS",
                                                             "value":  "*"
                                                         },
                                                         {
                                                             "name":  "AWS_REGION",
                                                             "value":  "us-east-2"
                                                         },
                                                         {
                                                             "name":  "AWS_SQS_QUEUE_NAME",
                                                             "value":  "screening-requests"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_MOCK",
                                                             "value":  "false"
                                                         },
                                                         {
                                                             "name":  "AUTH_ENABLED",
                                                             "value":  "false"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_BASE_URL",
                                                             "value":  "https://api.opensanctions.org"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_API_KEY",
                                                             "value":  "ddae133d0725fee8b8b2f6d3bcc28f23"
                                                         }
                                                     ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/ofac-screening-backend",
                                                                              "awslogs-region":  "us-east-2",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          }
                                 }
                             ]
}