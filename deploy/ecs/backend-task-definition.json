                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/backend-config:APP_DB_URL::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_SECRET",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_CLIENT_SECRET::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_API_KEY",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_API_KEY::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_BEARER_TOKEN",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_BEARER_TOKEN::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY_B64",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY_B64::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY",
                                                         "valueFrom":  "arn:aws:secretsmanager:us-east-2:279930135954:secret:ofac-screening/actimize-config:ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY::"
