{
    "family":  "ofac-screening-backend",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "512",
    "executionRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-execution-role",
    "taskRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-role",
    "containerDefinitions":  [
                                 {
                                     "name":  "backend",
                                     "image":  "279930135954.dkr.ecr.us-east-2.amazonaws.com/ofac-screening-backend:20260302155921",
                                     "essential":  true,
                                     "command":  [
                                                     "uvicorn",
                                                     "app.main:app",
                                                     "--host",
                                                     "0.0.0.0",
                                                     "--port",
                                                     "8000"
                                                 ],
                                     "portMappings":  [
                                                          {
                                                              "name":  "api",
                                                              "containerPort":  8000,
                                                              "hostPort":  8000,
                                                              "protocol":  "tcp",
                                                              "appProtocol":  "http"
                                                          }
                                                      ],
                                     "environment":  [
                                                         {
                                                             "name":  "APP_DB_PATH",
                                                             "value":  "/tmp/screening.db"
                                                         },
                                                         {
                                                             "name":  "CORS_ALLOW_ORIGINS",
                                                             "value":  "*"
                                                         },
                                                         {
                                                             "name":  "AWS_REGION",
                                                             "value":  "us-east-2"
                                                         },
                                                         {
                                                             "name":  "AWS_SQS_QUEUE_NAME",
                                                             "value":  "screening-requests"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_MOCK",
                                                             "value":  "false"
                                                         },
                                                         {
                                                             "name":  "AUTH_ENABLED",
                                                             "value":  "true"
                                                         },
                                                         {
                                                             "name":  "AUTH_ISSUER",
                                                             "value":  "https://cognito-idp.us-east-2.amazonaws.com/us-east-2_ptvmAe35M"
                                                         },
                                                         {
                                                             "name":  "AUTH_JWKS_URL",
                                                             "value":  "https://cognito-idp.us-east-2.amazonaws.com/us-east-2_ptvmAe35M/.well-known/jwks.json"
                                                         },
                                                         {
                                                             "name":  "AUTH_AUDIENCE",
                                                             "value":  "2ul9mdnt44kl60hgiihbc7o5sk"
                                                         },
                                                         {
                                                             "name":  "AUTH_ALGORITHMS",
                                                             "value":  "RS256"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_BASE_URL",
                                                             "value":  "https://api.opensanctions.org"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_API_KEY",
                                                             "value":  "ddae133d0725fee8b8b2f6d3bcc28f23"
                                                         },
                                                         {
                                                             "name":  "APP_DB_URL",
                                                             "value":  "postgresql://screening_admin:wab%29Mg%5EP-n2L%2AV7h%5Ef2%5DWxdi@screening-postgres-dev.c1y8yq0u2xoz.us-east-2.rds.amazonaws.com:5432/screening?sslmode=require"
                                                         },
                                                         {
                                                             "name":  "AWS_S3_UPLOAD_BUCKET",
                                                             "value":  "amzn-s3-quickscreen-batch"
                                                         },
                                                         {
                                                             "name":  "AWS_S3_UPLOAD_PREFIX",
                                                             "value":  "screening-input"
                                                         }
                                                     ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/ofac-screening-backend",
                                                                              "awslogs-region":  "us-east-2",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          }
                                 }
                             ]
}
