{
    "family":  "ofac-screening-worker",
    "networkMode":  "awsvpc",
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "256",
    "memory":  "2048",
    "executionRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-execution-role",
    "taskRoleArn":  "arn:aws:iam::279930135954:role/ofac-screening-task-role",
    "containerDefinitions":  [
                                 {
                                     "name":  "worker",
                                     "image":  "279930135954.dkr.ecr.us-east-2.amazonaws.com/ofac-screening-worker:20260309174650",
                                     "essential":  true,
                                     "command":  [
                                                     "python",
                                                     "-m",
                                                     "app.worker"
                                                 ],
                                     "environment":  [
                                                         {
                                                             "name":  "APP_DB_PATH",
                                                             "value":  "/tmp/screening.db"
                                                         },
                                                         {
                                                             "name":  "AWS_REGION",
                                                             "value":  "us-east-2"
                                                         },
                                                         {
                                                             "name":  "AWS_SQS_QUEUE_NAME",
                                                             "value":  "screening-requests"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_MOCK",
                                                             "value":  "false"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_LOG_RAW_API_IO",
                                                             "value":  "true"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_RAW_API_LOG_MAX_CHARS",
                                                             "value":  "20000"
                                                         },
                                                         {
                                                             "name":  "SCREENING_TPS",
                                                             "value":  "26"
                                                         },
                                                         {
                                                             "name":  "SCREENING_PARALLEL_MESSAGES",
                                                             "value":  "15"
                                                         },
                                                         {
                                                             "name":  "SCREENING_ITEM_RETRY_MAX_ATTEMPTS",
                                                             "value":  "2"
                                                         },
                                                         {
                                                             "name":  "SCREENING_ITEM_RETRY_INITIAL_DELAY_S",
                                                             "value":  "3"
                                                         },
                                                         {
                                                             "name":  "SCREENING_ITEM_RETRY_MAX_DELAY_S",
                                                             "value":  "60"
                                                         },
                                                         {
                                                             "name":  "DAILY_SCREENING_TIMEZONE",
                                                             "value":  "America/New_York"
                                                         },
                                                         {
                                                             "name":  "DAILY_SCREENING_HOUR",
                                                             "value":  "0"
                                                         },
                                                         {
                                                             "name":  "DAILY_SCREENING_MINUTE",
                                                             "value":  "5"
                                                         },
                                                         {
                                                             "name":  "DAILY_SCREENING_CHECK_INTERVAL_S",
                                                             "value":  "30"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_BASE_URL",
                                                             "value":  "https://us-dev.apis.prudential.com/financial-governance/sanctions-screening/v1"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_ALERT_REVIEW_URL",
                                                             "value":  ""
                                                         },
                                                         {
                                                             "name":  "AWS_S3_UPLOAD_BUCKET",
                                                             "value":  "amzn-s3-quickscreen-batch"
                                                         },
                                                         {
                                                             "name":  "AWS_S3_UPLOAD_PREFIX",
                                                             "value":  "screening-input"
                                                         },
                                                         {
                                                             "name":  "AWS_SNS_NOTIFICATIONS_ENABLED",
                                                             "value":  "true"
                                                         },
                                                         {
                                                             "name":  "AWS_SNS_SCHEDULE_TOPIC_PREFIX",
                                                             "value":  "ofac-screening-schedule"
                                                         },
                                                         {
                                                             "name":  "AWS_NOTIFICATION_DELIVERY_MODE",
                                                             "value":  "SES"
                                                         },
                                                         {
                                                             "name":  "AWS_SES_SENDER_EMAIL",
                                                             "value":  "no-reply@prudential.com"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_PROVIDER",
                                                             "value":  "prudential"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_SOURCE_SYSTEM",
                                                             "value":  "AMLP"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_TOKEN_URL",
                                                             "value":  "https://us-dev.apis.prudential.com/utility/identity-management/v2/oauth2/token"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_CLIENT_ID",
                                                             "value":  "ZiPqKLBeUjxysmwyh3LbMT7plYzeIEuy"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_SCOPE",
                                                             "value":  "api://api-dev.pruvpcaws066.pruaws.prudential.com/sanction_screening_api_v1/.default"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_CLIENT_ASSERTION_TYPE",
                                                             "value":  "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_CLIENT_ASSERTION_ALGORITHM",
                                                             "value":  "RS256"
                                                         },
                                                         {
                                                             "name":  "ACTIMIZE_CLIENT_ASSERTION_AUDIENCE",
                                                             "value":  "https://sso.dev.prudential.com:443/am/oauth2"
                                                         }
                                                     ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/ofac-screening-worker",
                                                                              "awslogs-region":  "us-east-2",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          },
                                     "secrets":  [
                                                     {
                                                         "name":  "APP_DB_URL",
                                                         "valueFrom":  "ofac-screening/app-secrets:APP_DB_URL::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_SECRET",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_CLIENT_SECRET::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_API_KEY",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_API_KEY::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_BEARER_TOKEN",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_BEARER_TOKEN::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY_B64",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY_B64::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY_PATH",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_CLIENT_ASSERTION_PRIVATE_KEY_PATH::"
                                                     },
                                                     {
                                                         "name":  "ACTIMIZE_CLIENT_ASSERTION_KID",
                                                         "valueFrom":  "ofac-screening/app-secrets:ACTIMIZE_CLIENT_ASSERTION_KID::"
                                                     }
                                                 ]
                                 }
                             ]
}
