APP_NAME=OFAC Screening Enterprise API
APP_VERSION=1.0.0
APP_DB_PATH=/data/screening.db
CORS_ALLOW_ORIGINS=*

AWS_REGION=us-east-1
AWS_SQS_QUEUE_NAME=screening-requests
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

ACTIMIZE_MOCK=true
ACTIMIZE_BASE_URL=
ACTIMIZE_API_KEY=
ACTIMIZE_TIMEOUT_S=10

SCREENING_TPS=32
SCREENING_POLL_INTERVAL_MS=500
SCREENING_SYNC_TIMEOUT_S=90
SCREENING_RESULT_LIMIT=5
DAILY_SCREENING_TIMEZONE=America/New_York
DAILY_SCREENING_HOUR=0
DAILY_SCREENING_MINUTE=5
DAILY_SCREENING_CHECK_INTERVAL_S=30
AUTH_ENABLED=true
AUTH_ISSUER=http://localhost:8081/realms/screening-local
AUTH_JWKS_URL=http://localhost:8081/realms/screening-local/protocol/openid-connect/certs
AUTH_AUDIENCE=
AUTH_ALGORITHMS=RS256
